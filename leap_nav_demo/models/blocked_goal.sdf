<?xml version="1.0"?>
<sdf version="1.6">
  <model name="demo_obstacle">
    <static>true</static>
    <link name="box_link">
      <collision name="box_collision">
        <geometry><box><size>0.35 0.10 0.50</size></box></geometry>
      </collision>
      <visual name="box_visual">
        <geometry><box><size>0.35 0.10 0.50</size></box></geometry>
        <material><ambient>0.9 0.45 0.1 1</ambient><diffuse>0.9 0.45 0.1 1</diffuse></material>
      </visual>
      <sensor name="box_contacts" type="contact">
        <always_on>true</always_on>
        <update_rate>20</update_rate>
        <contact><collision>box_collision</collision></contact>
        <plugin name="obstacle_contact_monitor" filename="libgazebo_ros_bumper.so">
          <ros><namespace>/demo</namespace><remapping>bumper_states:=obstacle_contacts</remapping></ros>
          <frame_name>world</frame_name>
        </plugin>
      </sensor>
    </link>
  </model>
</sdf>
