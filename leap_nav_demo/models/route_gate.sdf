<?xml version="1.0"?>
<sdf version="1.6">
  <model name="demo_obstacle">
    <static>true</static>
    <link name="gate">
      <collision name="gate_collision"><geometry><box><size>1.00 0.10 0.50</size></box></geometry></collision>
      <visual name="gate_visual"><geometry><box><size>1.00 0.10 0.50</size></box></geometry>
        <material><ambient>0.8 0.25 0.1 1</ambient></material></visual>
      <sensor name="gate_contacts" type="contact">
        <always_on>true</always_on><update_rate>20</update_rate>
        <contact><collision>gate_collision</collision></contact>
        <plugin name="route_gate_contact_monitor" filename="libgazebo_ros_bumper.so">
          <ros><namespace>/demo</namespace><remapping>bumper_states:=obstacle_contacts</remapping></ros>
          <frame_name>world</frame_name>
        </plugin>
      </sensor>
    </link>
  </model>
</sdf>
